{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions de Trame : contrôles fenêtre, démarrage auto, état de fenêtre, sidecar backend, ouverture des liens.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-maximize",
    "core:window:allow-unmaximize",
    "core:window:allow-close",
    "core:window:allow-hide",
    "core:window:allow-start-dragging",
    "core:window:allow-start-resize-dragging",
    "autostart:allow-enable",
    "autostart:allow-disable",
    "autostart:allow-is-enabled",
    "window-state:default",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "binaries/trame-backend",
          "sidecar": true
        }
      ]
    },
    "shell:allow-open",
    "allow-restart-backend",
    "allow-check-update",
    "allow-install-update",
    "allow-teams-web-open",
    "allow-teams-web-hide",
    "allow-teams-web-close",
    "allow-teams-web-eval"
  ]
}
