{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Trame",
  "version": "0.1.0",
  "identifier": "ovh.battistella.trame",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Trame",
        "width": 1040,
        "height": 720,
        "minWidth": 720,
        "minHeight": 520,
        "decorations": false,
        "transparent": false,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico", "icons/icon.icns"],
    "externalBin": ["binaries/trame-backend"]
  }
}
