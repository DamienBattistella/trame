{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Trame",
  "version": "0.1.0",
  "identifier": "ovh.battistella.trame",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Trame",
        "shadow": true,
        "width": 1040,
        "height": 720,
        "minWidth": 720,
        "minHeight": 520,
        "decorations": false,
        "transparent": false,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "externalBin": [
      "binaries/trame-backend"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDBDREFFQ0I3NEJGRjlGNjMKUldSam4vOUx0K3phREhGTzVqZDIvanBQb24yUFdaeVdoQXFPMG5WdVNiZmloU2RrZFBkQlJycDAK",
      "endpoints": [
        "https://github.com/DamienBattistella/trame/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
